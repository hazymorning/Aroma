<?xml version="1.0" encoding="utf-8"?>
<!--
    The scrim fading in above words set on a photo: clear at the top, @color/widget_scrim at the foot,
    where the scrim behind the words takes over. Eased at both ends, so neither edge shows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="8dp"
    android:height="8dp"
    android:viewportWidth="8"
    android:viewportHeight="8">
    <path android:pathData="M0,0 h8 v8 h-8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="8"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#00000000"
                    android:offset="0" />
                <item
                    android:color="#07000000"
                    android:offset="0.125" />
                <item
                    android:color="#18000000"
                    android:offset="0.25" />
                <item
                    android:color="#30000000"
                    android:offset="0.375" />
                <item
                    android:color="#4C000000"
                    android:offset="0.5" />
                <item
                    android:color="#69000000"
                    android:offset="0.625" />
                <item
                    android:color="#81000000"
                    android:offset="0.75" />
                <item
                    android:color="#92000000"
                    android:offset="0.875" />
                <item
                    android:color="#99000000"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
