<?xml version="1.0" encoding="utf-8"?>
<!--
    The shopping widget in the picker before Android 15: its two by two layout with a sample list.
    Launchers inflate it as RemoteViews, with the platform's views, so tints are android:tint.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_preview_list"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_left"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle"
                android:backgroundTint="@color/widget_cta"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                android:tint="@color/widget_on_cta"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        style="@style/WidgetPreviewItem"
        android:text="@string/widget_preview_apples" />

    <TextView
        style="@style/WidgetPreviewItem"
        android:text="@string/widget_preview_lemons" />

    <TextView
        style="@style/WidgetPreviewItem"
        android:text="@string/widget_preview_milk" />
</LinearLayout>
