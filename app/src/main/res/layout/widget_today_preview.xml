<?xml version="1.0" encoding="utf-8"?>
<!--
    The Today widget in the picker before Android 15: its four by two layout with a sample day.
    Launchers inflate it as RemoteViews, with the platform's views, so tints are android:tint.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:backgroundTint="@color/widget_card">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_plate"
            android:tint="@color/widget_on_surface_variant"
            tools:ignore="UseAppTint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            style="@style/WidgetPreviewMealKind"
            android:text="@string/meal_dinner" />

        <TextView
            style="@style/WidgetPreviewMealName"
            android:text="@string/widget_preview_dinner" />

        <TextView
            style="@style/WidgetPreviewMealKind"
            android:layout_marginTop="16dp"
            android:text="@string/meal_dessert" />

        <TextView
            style="@style/WidgetPreviewMealName"
            android:text="@string/widget_preview_dessert" />
    </LinearLayout>
</LinearLayout>
