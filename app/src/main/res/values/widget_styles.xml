<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- An item in the shopping widget's preview: the check's ring on the keyline, then its words. -->
    <style name="WidgetPreviewItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/widget_check_off</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/widget_ring</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
