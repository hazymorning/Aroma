<?xml version="1.0" encoding="utf-8"?>
<!-- Never read while allowBackup is false; lint asks for it as long as Android 11 and older are supported. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
