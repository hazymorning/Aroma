<?xml version="1.0" encoding="utf-8"?>
<!-- The session is encrypted with a key that cannot leave this device, so nothing is transferred.
     allowBackup="false" turns backups off, but from Android 12 no longer a transfer to a new device. -->
<data-extraction-rules>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
